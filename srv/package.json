{
  "name": "@n-coreshift/srv",
  "version": "0.1.0",
  "description": "N-CoreShift – CAP backend service",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "cds watch --open false",
    "start": "cds run",
    "api": "ts-node -P tsconfig.json src/server.ts",
    "api:build": "tsc -p tsconfig.json && node dist/server.js",
    "test": "jest --forceExit",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sap/cds": "^8.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
