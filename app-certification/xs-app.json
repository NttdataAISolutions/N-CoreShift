{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 30,
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/index.html"
  },
  "routes": [
    {
      "source": "^/api/ncoreiq/(.*)$",
      "target": "/api/ncoreiq/$1",
      "destination": "ncoreshift-python",
      "authenticationType": "xsuaa",
      "identityProvider": "sap.custom",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": "dist",
      "authenticationType": "xsuaa",
      "identityProvider": "sap.custom"
    }
  ]
}
