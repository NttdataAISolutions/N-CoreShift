# N-CoreShift Environment Configuration
# Copy this file to .env and fill in values for local development.
# Never commit .env to source control.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4005
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Local SQLite (default for development)
DB_KIND=sqlite
DB_URL=./ncoreshift.sqlite

# ── AI Provider ──────────────────────────────────────────────────────────────
# Supported values: sap-ai-core | sap-ai-interface | openai
AI_PROVIDER=sap-ai-interface

# SAP AI Core / Generative AI Hub
SAP_AI_CORE_BASE_URL=
SAP_AI_CORE_CLIENT_ID=
SAP_AI_CORE_CLIENT_SECRET=
SAP_AI_CORE_AUTH_URL=
SAP_AI_CORE_RESOURCE_GROUP=default
SAP_AI_CORE_MODEL=gpt-4o

# SAP AI Interface (shared N-Suite integration)
SAP_AI_INTERFACE_URL=
SAP_AI_INTERFACE_API_KEY=

# OpenAI (local/dev fallback only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Authentication ────────────────────────────────────────────────────────────
# dev | xsuaa
AUTH_PROVIDER=dev

# XSUAA (BTP production)
XSUAA_URL=
XSUAA_CLIENT_ID=
XSUAA_CLIENT_SECRET=

# ── File Storage ──────────────────────────────────────────────────────────────
# local | object-store
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_PATH=./uploads

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_UNCOMPRESSED_MB=200

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
