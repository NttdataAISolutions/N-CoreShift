{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 30,
  "destinations": {
    "ncoreshift-test-python": {
      "logoutPath": "/do/logout",
      "logoutMethod": "POST"
    }
  },
  "routes": [
    {
      "source": "^/api/ncoreiq/(.*)$",
      "target": "/api/ncoreiq/$1",
      "destination": "ncoreshift-test-python",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "ncoreshift-test-python",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": "dist",
      "authenticationType": "none"
    }
  ]
}
